{
  "schema_version": 1,
  "title": "EEK5106 Semiconductor Yield and Failure Analysis Glossary",
  "title_zh": "EEK5106 半导体良率与失效分析专业词汇",
  "description": "Technical vocabulary used throughout the active course question bank.",
  "description_zh": "本课程题库涉及的核心专业术语，用于查阅与主动回忆。",
  "terms": [
    {"id":"semiconductor-industry","term":"Semiconductor Industry","term_zh":"半导体产业","definition_zh":"围绕半导体设计、制造、封装、测试及配套服务形成的产业体系。","category":"Industry & Manufacturing"},
    {"id":"wafer-fabrication","term":"Wafer Fabrication","term_zh":"晶圆制造","aliases":["wafer fab"],"definition_zh":"在晶圆上通过一系列工艺形成器件与互连结构的制造阶段。","category":"Industry & Manufacturing"},
    {"id":"foundry","term":"Foundry","term_zh":"晶圆代工厂","definition_zh":"使用自有制造设施为外部客户生产芯片的企业。","category":"Industry & Manufacturing"},
    {"id":"fabless","term":"Fabless","term_zh":"无晶圆厂模式","definition_zh":"专注芯片设计并将晶圆制造外包的商业模式。","category":"Industry & Manufacturing"},
    {"id":"integrated-device-manufacturer","term":"Integrated Device Manufacturer","term_zh":"集成器件制造商","aliases":["IDM"],"definition_zh":"在同一企业内完成芯片设计、制造和销售的厂商。","category":"Industry & Manufacturing"},
    {"id":"outsourced-semiconductor-assembly-and-test","term":"Outsourced Semiconductor Assembly and Test","term_zh":"半导体封装测试外包服务","aliases":["OSAT"],"definition_zh":"为芯片厂商提供切割、封装和测试等后段服务的企业。","category":"Industry & Manufacturing"},
    {"id":"electronic-design-automation","term":"Electronic Design Automation","term_zh":"电子设计自动化","aliases":["EDA"],"definition_zh":"用于设计、分析和验证复杂集成电路的软件工具体系。","category":"Industry & Manufacturing"},
    {"id":"design-for-manufacturability","term":"Design for Manufacturability","term_zh":"可制造性设计","aliases":["DFM"],"definition_zh":"在设计阶段考虑制造能力，以提升良率并降低制造风险。","category":"Industry & Manufacturing"},
    {"id":"time-to-market","term":"Time-to-Market","term_zh":"产品上市周期","aliases":["time to market"],"definition_zh":"从产品构想到完成开发并进入市场所需的时间。","category":"Industry & Manufacturing"},
    {"id":"integrated-circuit","term":"Integrated Circuit","term_zh":"集成电路","aliases":["IC"],"definition_zh":"在单一半导体基片上集成多个电子器件与互连的电路。","category":"Industry & Manufacturing"},
    {"id":"wafer","term":"Wafer","term_zh":"晶圆","definition_zh":"用于制造多个半导体芯片的薄片状基底材料。","category":"Wafer Process"},
    {"id":"die","term":"Die","term_zh":"裸片","definition_zh":"晶圆切割后得到的单个未封装芯片。","category":"Wafer Process"},
    {"id":"substrate","term":"Substrate","term_zh":"衬底","definition_zh":"承载器件、薄膜或封装互连的基础材料。","category":"Wafer Process"},
    {"id":"front-end-of-line","term":"Front-End-of-Line","term_zh":"晶圆制造前段","aliases":["FEOL"],"definition_zh":"主要形成晶体管等有源器件结构的制造阶段。","category":"Wafer Process"},
    {"id":"back-end-of-line","term":"Back-End-of-Line","term_zh":"晶圆制造后段","aliases":["BEOL"],"definition_zh":"在已形成的器件上构建金属互连与层间介质的制造阶段。","category":"Wafer Process"},
    {"id":"far-back-end-of-line","term":"Far-Back-End-of-Line","term_zh":"远后段工艺","aliases":["FBEOL"],"definition_zh":"衔接晶圆制造与封装、板级组装的后续制造环节。","category":"Wafer Process"},
    {"id":"wafer-growth","term":"Wafer Growth","term_zh":"晶圆生长","definition_zh":"制备半导体单晶并形成晶圆材料的过程。","category":"Wafer Process"},
    {"id":"czochralski-process","term":"Czochralski","term_zh":"直拉单晶法","aliases":["CZ"],"definition_zh":"从熔体中提拉晶种以生长单晶硅棒的方法。","category":"Wafer Process"},
    {"id":"photolithography","term":"Photolithography","term_zh":"光刻","aliases":["optical lithography"],"definition_zh":"利用光和掩模将电路图形转移到光刻胶及晶圆上的工艺。","category":"Patterning & Etch"},
    {"id":"photoresist","term":"Photoresist","term_zh":"光刻胶","definition_zh":"曝光后溶解特性发生变化、用于承载图形的感光材料。","category":"Patterning & Etch"},
    {"id":"photomask","term":"Photomask","term_zh":"光掩模","aliases":["reticle"],"definition_zh":"包含待转移电路图形并用于曝光的掩模板。","category":"Patterning & Etch"},
    {"id":"step-and-scan-system","term":"Step & Scan System","term_zh":"步进扫描曝光系统","aliases":["step-and-scan"],"definition_zh":"通过步进与狭缝扫描将掩模图形投影到晶圆各曝光场的设备。","category":"Patterning & Etch"},
    {"id":"electron-beam-lithography","term":"Electron Beam Lithography","term_zh":"电子束光刻","aliases":["electron-beam lithography","EBL"],"definition_zh":"以聚焦电子束直接写入精细图形的无掩模曝光技术。","category":"Patterning & Etch"},
    {"id":"ion-beam-lithography","term":"Ion Beam Lithography","term_zh":"离子束光刻","definition_zh":"利用聚焦离子束形成或转移微细图形的技术。","category":"Patterning & Etch"},
    {"id":"etching","term":"Etching","term_zh":"刻蚀","aliases":["etch"],"definition_zh":"选择性去除材料以把图形转移到下层薄膜的工艺。","category":"Patterning & Etch"},
    {"id":"pattern-etch","term":"Pattern Etch","term_zh":"图形刻蚀","definition_zh":"借助光刻胶或硬掩模把图形转移到下层材料的刻蚀。","category":"Patterning & Etch"},
    {"id":"blanket-etch","term":"Blanket Etch","term_zh":"全面刻蚀","definition_zh":"不进行图形转移而在整个表面去除全部或部分薄膜的刻蚀。","category":"Patterning & Etch"},
    {"id":"wet-etch","term":"Wet Etch","term_zh":"湿法刻蚀","aliases":["wet etching"],"definition_zh":"使用液相化学品溶解并去除材料的刻蚀方法。","category":"Patterning & Etch"},
    {"id":"dry-etch","term":"Dry Etch","term_zh":"干法刻蚀","aliases":["dry etching"],"definition_zh":"使用气相反应物或等离子体去除材料的刻蚀方法。","category":"Patterning & Etch"},
    {"id":"reactive-ion-etching","term":"Reactive Ion Etching","term_zh":"反应离子刻蚀","aliases":["RIE"],"definition_zh":"结合活性化学物种与高能离子轰击的干法刻蚀。","category":"Patterning & Etch"},
    {"id":"isotropic-etching","term":"Isotropic Etching","term_zh":"各向同性刻蚀","definition_zh":"各方向刻蚀速率近似相同、易产生侧向钻蚀的工艺。","category":"Patterning & Etch"},
    {"id":"anisotropic-etching","term":"Anisotropic Etching","term_zh":"各向异性刻蚀","definition_zh":"不同方向刻蚀速率不同、可形成较垂直侧壁的工艺。","category":"Patterning & Etch"},
    {"id":"etch-rate","term":"Etch Rate","term_zh":"刻蚀速率","definition_zh":"单位时间内材料被去除的厚度或数量。","category":"Patterning & Etch"},
    {"id":"etch-selectivity","term":"Etch Selectivity","term_zh":"刻蚀选择比","definition_zh":"目标材料相对于掩模或其他材料的刻蚀速率比。","category":"Patterning & Etch"},
    {"id":"critical-dimension","term":"Critical Dimension","term_zh":"关键尺寸","aliases":["CD"],"definition_zh":"决定器件或图形性能、需要严格控制的特征尺寸。","category":"Patterning & Etch"},
    {"id":"ion-implantation","term":"Ion Implantation","term_zh":"离子注入","definition_zh":"将加速离子注入半导体以改变其电学性质的工艺。","category":"Doping & Thermal Process"},
    {"id":"doping","term":"Doping","term_zh":"掺杂","definition_zh":"有意引入杂质以调节半导体载流子浓度和导电类型。","category":"Doping & Thermal Process"},
    {"id":"n-type","term":"n-type","term_zh":"n 型","definition_zh":"以电子为多数载流子的半导体导电类型。","category":"Doping & Thermal Process"},
    {"id":"p-type","term":"p-type","term_zh":"p 型","definition_zh":"以空穴为多数载流子的半导体导电类型。","category":"Doping & Thermal Process"},
    {"id":"annealing","term":"Annealing","term_zh":"退火","definition_zh":"通过热处理修复晶格损伤、激活掺杂或改善材料性质的过程。","category":"Doping & Thermal Process"},
    {"id":"rapid-thermal-annealing","term":"Rapid Thermal Annealing","term_zh":"快速热退火","aliases":["RTA"],"definition_zh":"快速升降温、以较短热预算完成退火的工艺。","category":"Doping & Thermal Process"},
    {"id":"thermal-oxidation","term":"Thermal Oxidation","term_zh":"热氧化","definition_zh":"在高温含氧环境中使硅表面生长二氧化硅的工艺。","category":"Doping & Thermal Process"},
    {"id":"chemical-vapor-deposition","term":"Chemical Vapor Deposition","term_zh":"化学气相沉积","aliases":["CVD"],"definition_zh":"气相前驱体在衬底附近或表面发生化学反应并形成固态薄膜的沉积方法。","category":"Thin Films & Interconnect"},
    {"id":"physical-vapor-deposition","term":"Physical Vapor Deposition","term_zh":"物理气相沉积","aliases":["PVD"],"definition_zh":"以蒸发或溅射等物理方式把源材料转移并凝结到衬底上的沉积方法。","category":"Thin Films & Interconnect"},
    {"id":"electrochemical-plating","term":"Electrochemical Plating","term_zh":"电化学镀覆","aliases":["ECP"],"definition_zh":"在电解液中通过电化学还原沉积金属的工艺。","category":"Thin Films & Interconnect"},
    {"id":"chemical-mechanical-polishing","term":"Chemical Mechanical Polishing","term_zh":"化学机械抛光","aliases":["CMP"],"definition_zh":"结合浆料化学反应和抛光垫机械作用实现材料去除与平坦化的工艺。","category":"Thin Films & Interconnect"},
    {"id":"planarization","term":"Planarization","term_zh":"平坦化","definition_zh":"降低表面高低起伏，为后续高分辨率加工提供平整表面的过程。","category":"Thin Films & Interconnect"},
    {"id":"thin-film","term":"Thin Film","term_zh":"薄膜","aliases":["thin-film"],"definition_zh":"沉积或生长在衬底表面的微薄材料层。","category":"Thin Films & Interconnect"},
    {"id":"metallization","term":"Metallization","term_zh":"金属化","definition_zh":"形成金属导线、接触和互连结构的制造过程。","category":"Thin Films & Interconnect"},
    {"id":"interconnect","term":"Interconnect","term_zh":"互连","definition_zh":"在器件、芯片或系统部件之间传输电信号与电源的导电结构。","category":"Thin Films & Interconnect"},
    {"id":"local-interconnect","term":"Local Interconnect","term_zh":"局部互连","aliases":["local interconnects"],"definition_zh":"连接小区域内相邻器件的短距离芯片内互连。","category":"Thin Films & Interconnect"},
    {"id":"global-interconnect","term":"Global Interconnect","term_zh":"全局互连","aliases":["global interconnects"],"definition_zh":"跨越芯片较大区域的长距离互连。","category":"Thin Films & Interconnect"},
    {"id":"low-k-dielectric","term":"low-k dielectric","term_zh":"低介电常数介质","aliases":["low-k"],"definition_zh":"以较低介电常数减小互连寄生电容的绝缘材料。","category":"Thin Films & Interconnect"},
    {"id":"diffusion-barrier","term":"Diffusion Barrier","term_zh":"扩散阻挡层","definition_zh":"抑制铜等材料向邻近介质扩散的薄层。","category":"Thin Films & Interconnect"},
    {"id":"damascene","term":"Damascene","term_zh":"镶嵌工艺","definition_zh":"先在介质中形成沟槽或通孔，再填充金属并抛光的互连工艺。","category":"Thin Films & Interconnect"},
    {"id":"rc-delay","term":"RC Delay","term_zh":"RC 延迟","definition_zh":"由互连电阻与电容共同导致的信号传播延迟。","category":"Thin Films & Interconnect"},
    {"id":"transistor","term":"Transistor","term_zh":"晶体管","definition_zh":"利用控制端调节另外两端电流、实现开关或放大的器件。","category":"Devices & Memory"},
    {"id":"bipolar-junction-transistor","term":"Bipolar Junction Transistor","term_zh":"双极结型晶体管","aliases":["BJT"],"definition_zh":"利用电子和空穴两类载流子工作的结型晶体管。","category":"Devices & Memory"},
    {"id":"metal-oxide-semiconductor","term":"Metal-Oxide-Semiconductor","term_zh":"金属-氧化物-半导体结构","aliases":["MOS"],"definition_zh":"由栅电极、氧化物绝缘层和半导体构成的器件结构。","category":"Devices & Memory"},
    {"id":"mosfet","term":"MOS Field-Effect Transistor","term_zh":"MOS 场效应晶体管","aliases":["MOSFET"],"definition_zh":"由绝缘栅电场控制源漏沟道导电性的场效应晶体管。","category":"Devices & Memory"},
    {"id":"cmos","term":"Complementary MOS","term_zh":"互补式 MOS","aliases":["CMOS"],"definition_zh":"配对使用 n 型与 p 型 MOSFET、以降低静态功耗的电路技术。","category":"Devices & Memory"},
    {"id":"bicmos","term":"Bipolar CMOS","term_zh":"双极-CMOS 集成技术","aliases":["BiCMOS"],"definition_zh":"结合双极器件高速高驱动能力与 CMOS 低功耗特性的技术。","category":"Devices & Memory"},
    {"id":"gate-oxide","term":"Gate Oxide","term_zh":"栅氧化层","aliases":["gate-oxide"],"definition_zh":"MOS 栅极与半导体沟道之间的绝缘氧化物层。","category":"Devices & Memory"},
    {"id":"source-drain","term":"Source/Drain","term_zh":"源/漏区","aliases":["source-drain"],"definition_zh":"场效应晶体管中向沟道提供和收集载流子的两个区域。","category":"Devices & Memory"},
    {"id":"isolation","term":"Isolation","term_zh":"器件隔离","definition_zh":"阻止相邻器件之间产生不希望电耦合或漏电的结构。","category":"Devices & Memory"},
    {"id":"static-random-access-memory","term":"Static Random-Access Memory","term_zh":"静态随机存取存储器","aliases":["SRAM"],"definition_zh":"通电期间利用锁存结构保持数据、无需周期刷新的易失性存储器。","category":"Devices & Memory"},
    {"id":"dynamic-random-access-memory","term":"Dynamic Random-Access Memory","term_zh":"动态随机存取存储器","aliases":["DRAM"],"definition_zh":"以晶体管和电容单元存储电荷、需要周期刷新的易失性存储器。","category":"Devices & Memory"},
    {"id":"flash-memory","term":"Flash Memory","term_zh":"闪存","definition_zh":"通常利用浮栅或电荷俘获结构保存信息的可擦写非易失性存储器。","category":"Devices & Memory"},
    {"id":"nand-flash","term":"NAND Flash","term_zh":"NAND 闪存","aliases":["NAND"],"definition_zh":"面向高密度、低成本串行访问存储的闪存架构。","category":"Devices & Memory"},
    {"id":"nor-flash","term":"NOR Flash","term_zh":"NOR 闪存","aliases":["NOR"],"definition_zh":"支持随机访问、常用于嵌入式代码存储的闪存架构。","category":"Devices & Memory"},
    {"id":"eeprom","term":"Electrically Erasable Programmable Read-Only Memory","term_zh":"电可擦可编程只读存储器","aliases":["EEPROM"],"definition_zh":"可通过电信号擦除并重新编程的非易失性存储器。","category":"Devices & Memory"},
    {"id":"phase-change-memory","term":"Phase-Change Memory","term_zh":"相变存储器","aliases":["PRAM"],"definition_zh":"利用材料不同相态的电阻差异存储信息的非易失性存储器。","category":"Devices & Memory"},
    {"id":"ferroelectric-ram","term":"Ferroelectric RAM","term_zh":"铁电随机存取存储器","aliases":["FRAM"],"definition_zh":"利用铁电极化状态存储信息的非易失性存储器。","category":"Devices & Memory"},
    {"id":"magnetoresistive-ram","term":"Magnetoresistive RAM","term_zh":"磁阻随机存取存储器","aliases":["MRAM"],"definition_zh":"利用磁性状态导致的电阻差异存储信息的非易失性存储器。","category":"Devices & Memory"},
    {"id":"resistive-ram","term":"Resistive RAM","term_zh":"阻变随机存取存储器","aliases":["RRAM"],"definition_zh":"通过可逆改变材料电阻状态存储信息的非易失性存储器。","category":"Devices & Memory"},
    {"id":"volatile-memory","term":"Volatile Memory","term_zh":"易失性存储器","definition_zh":"断电后所存信息会丢失的存储器。","category":"Devices & Memory"},
    {"id":"nonvolatile-memory","term":"Nonvolatile Memory","term_zh":"非易失性存储器","aliases":["non-volatile memory"],"definition_zh":"断电后仍能保留所存信息的存储器。","category":"Devices & Memory"},
    {"id":"floating-gate","term":"Floating Gate","term_zh":"浮栅","definition_zh":"被绝缘层包围、可长期保存电荷的存储器栅极结构。","category":"Devices & Memory"},
    {"id":"sense-amplifier","term":"Sense Amplifier","term_zh":"灵敏放大器","definition_zh":"检测并放大存储单元位线微小信号的电路。","category":"Devices & Memory"},
    {"id":"word-line","term":"Word Line","term_zh":"字线","definition_zh":"选择存储阵列中一行单元的控制线。","category":"Devices & Memory"},
    {"id":"bit-line","term":"Bit Line","term_zh":"位线","definition_zh":"在存储阵列中传送读写数据的列方向信号线。","category":"Devices & Memory"},
    {"id":"packaging","term":"Packaging","term_zh":"封装","definition_zh":"为裸片提供电气连接、机械保护、散热和环境隔离的制造环节。","category":"Packaging & Assembly"},
    {"id":"wire-bonding","term":"Wire Bonding","term_zh":"引线键合","aliases":["Wire Bond","Wire-bond","WB"],"definition_zh":"使用金、铝等细金属线连接芯片焊盘与封装端子的技术。","category":"Packaging & Assembly"},
    {"id":"flip-chip","term":"Flip Chip","term_zh":"倒装芯片","aliases":["Flip-Chip","FC"],"definition_zh":"将芯片翻转后通过凸点直接与衬底或电路板连接的封装技术。","category":"Packaging & Assembly"},
    {"id":"through-silicon-via","term":"Through-Silicon Via","term_zh":"硅通孔","aliases":["TSV"],"definition_zh":"穿过硅片、用于堆叠芯片层间垂直电连接的导电通孔。","category":"Packaging & Assembly"},
    {"id":"three-dimensional-integration","term":"3D Integration","term_zh":"三维集成","definition_zh":"沿垂直方向堆叠并互连芯片或器件层的集成方式。","category":"Packaging & Assembly"},
    {"id":"system-in-package","term":"System in Package","term_zh":"系统级封装","aliases":["SiP"],"definition_zh":"在单一封装内组合多个芯片及无源元件以实现系统功能。","category":"Packaging & Assembly"},
    {"id":"multichip-module","term":"Multichip Module","term_zh":"多芯片模块","aliases":["MCM"],"definition_zh":"在高布线密度衬底上集成两个或更多芯片的模块。","category":"Packaging & Assembly"},
    {"id":"chip-scale-package","term":"Chip Scale Package","term_zh":"芯片尺寸封装","aliases":["Chip Scale Packages","CSP"],"definition_zh":"外形尺寸与裸片接近的紧凑型封装。","category":"Packaging & Assembly"},
    {"id":"printed-circuit-board","term":"Printed Circuit Board","term_zh":"印刷电路板","aliases":["PCB"],"definition_zh":"承载并互连电子元件的绝缘基板与导电线路结构。","category":"Packaging & Assembly"},
    {"id":"through-hole-technology","term":"Thru-hole Technology","term_zh":"通孔插装技术","aliases":["THT"],"definition_zh":"将元件引脚穿过电路板孔后焊接的组装技术。","category":"Packaging & Assembly"},
    {"id":"surface-mount-technology","term":"Surface Mount Technology","term_zh":"表面贴装技术","aliases":["SMT"],"definition_zh":"将元件直接安装并焊接在电路板表面的组装技术。","category":"Packaging & Assembly"},
    {"id":"under-bump-metallisation","term":"Under Bump Metallisation","term_zh":"凸点下金属层","aliases":["UBM"],"definition_zh":"位于芯片焊盘与凸点之间、提供粘附和扩散阻挡等功能的金属层。","category":"Packaging & Assembly"},
    {"id":"intermetallic-compound","term":"Intermetallic Compound","term_zh":"金属间化合物","aliases":["IMC"],"definition_zh":"键合界面由不同金属反应形成、会影响连接可靠性的化合物。","category":"Packaging & Assembly"},
    {"id":"underfill","term":"Underfill","term_zh":"底部填充胶","definition_zh":"填充倒装芯片与衬底间隙、分担热机械应力的材料。","category":"Packaging & Assembly"},
    {"id":"molding-compound","term":"Molding Compound","term_zh":"塑封料","definition_zh":"包封并保护芯片和互连结构的聚合物封装材料。","category":"Packaging & Assembly"},
    {"id":"coefficient-of-thermal-expansion","term":"Coefficient of Thermal Expansion","term_zh":"热膨胀系数","aliases":["CTE"],"definition_zh":"材料温度每变化一度时尺寸相对变化的程度。","category":"Packaging & Assembly"},
    {"id":"solder-joint","term":"Solder Joint","term_zh":"焊点","definition_zh":"由焊料形成、提供机械固定和电气连接的接合点。","category":"Packaging & Assembly"},
    {"id":"bond-pad","term":"Bond Pad","term_zh":"键合焊盘","definition_zh":"芯片表面用于引线或凸点电连接的金属区域。","category":"Packaging & Assembly"},
    {"id":"die-separation","term":"Die Separation","term_zh":"芯片分离","aliases":["wafer dicing","dicing"],"definition_zh":"把完成制造的晶圆切割成单个裸片的工序。","category":"Packaging & Assembly"},
    {"id":"reliability","term":"Reliability","term_zh":"可靠性","definition_zh":"器件在规定条件和时间内持续完成预定功能的能力。","category":"Reliability & Failure"},
    {"id":"failure-analysis","term":"Failure Analysis","term_zh":"失效分析","definition_zh":"定位失效位置、识别失效机理并追查根本原因的系统过程。","category":"Reliability & Failure"},
    {"id":"electromigration","term":"Electromigration","term_zh":"电迁移","aliases":["EM"],"definition_zh":"高电流密度下金属原子迁移并导致互连开路或短路的现象。","category":"Reliability & Failure"},
    {"id":"time-dependent-dielectric-breakdown","term":"Time-Dependent Dielectric Breakdown","term_zh":"经时介质击穿","aliases":["Time Dependent Dielectric Breakdown","TDDB"],"definition_zh":"介质在长期电场应力下逐渐退化直至击穿的可靠性机理。","category":"Reliability & Failure"},
    {"id":"electrostatic-discharge","term":"Electrostatic Discharge","term_zh":"静电放电","aliases":["ESD"],"definition_zh":"静电荷快速转移产生的高电压或大电流事件，可损伤器件。","category":"Reliability & Failure"},
    {"id":"human-body-model","term":"Human Body Model","term_zh":"人体模型","aliases":["HBM"],"definition_zh":"模拟带电人体通过器件引脚放电的 ESD 测试模型。","category":"Reliability & Failure"},
    {"id":"machine-model","term":"Machine Model","term_zh":"机器模型","aliases":["MM"],"definition_zh":"模拟低阻低感机器或金属物体向器件放电的 ESD 模型。","category":"Reliability & Failure"},
    {"id":"charged-device-model","term":"Charged Device Model","term_zh":"带电器件模型","aliases":["CDM"],"definition_zh":"模拟器件自身带电后接触接地导体而放电的 ESD 模型。","category":"Reliability & Failure"},
    {"id":"high-temperature-operating-life","term":"High Temperature Operating Life","term_zh":"高温工作寿命试验","aliases":["HTOL"],"definition_zh":"在高温和工作偏置下加速器件老化的可靠性试验。","category":"Reliability & Failure"},
    {"id":"high-temperature-bake","term":"High Temperature Bake","term_zh":"高温烘烤试验","aliases":["HTB"],"definition_zh":"在高温存储条件下加速热激活失效机理的试验。","category":"Reliability & Failure"},
    {"id":"temperature-humidity-bias","term":"Temperature Humidity Bias","term_zh":"温湿偏压试验","aliases":["THB"],"definition_zh":"施加温度、湿度与电偏置以加速潮气相关失效的试验。","category":"Reliability & Failure"},
    {"id":"temperature-cycling","term":"Temperature Cycling","term_zh":"温度循环试验","aliases":["TC"],"definition_zh":"反复改变温度以加速材料热膨胀失配相关失效的试验。","category":"Reliability & Failure"},
    {"id":"ball-shear","term":"Ball Shear","term_zh":"焊球剪切试验","aliases":["BS"],"definition_zh":"施加横向力评估焊球或键合界面机械强度的试验。","category":"Reliability & Failure"},
    {"id":"dielectric-breakdown","term":"Dielectric Breakdown","term_zh":"介质击穿","definition_zh":"绝缘材料在过高电场下失去绝缘能力的失效。","category":"Reliability & Failure"},
    {"id":"thermal-stress","term":"Thermal Stress","term_zh":"热应力","definition_zh":"温度变化及材料热膨胀差异引起的机械应力。","category":"Reliability & Failure"},
    {"id":"bathtub-curve","term":"Bathtub Curve","term_zh":"浴盆曲线","definition_zh":"由早期失效、随机失效和耗损失效三阶段构成的典型失效率曲线。","category":"Reliability & Failure"},
    {"id":"infant-mortality","term":"Infant Mortality","term_zh":"早期失效","aliases":["infant-mortality"],"definition_zh":"产品使用初期由潜在缺陷或弱单元引起的较高失效阶段。","category":"Reliability & Failure"},
    {"id":"yield","term":"Yield","term_zh":"良率","definition_zh":"投入生产的器件中功能合格器件所占的比例。","category":"Yield & Defect Control"},
    {"id":"yield-engineering","term":"Yield Engineering","term_zh":"良率工程","aliases":["yield-engineering"],"definition_zh":"通过缺陷降低、过程优化、监控和根因分析提高合格产出的工程活动。","category":"Yield & Defect Control"},
    {"id":"yield-excursion","term":"Yield Excursion","term_zh":"良率异常","definition_zh":"良率偏离正常或预期水平、需要调查和处置的事件。","category":"Yield & Defect Control"},
    {"id":"yield-ramp","term":"Yield Ramp","term_zh":"良率爬坡","aliases":["yield-ramp"],"definition_zh":"新产品或新工艺从较低初始良率逐步改善并稳定的过程。","category":"Yield & Defect Control"},
    {"id":"defect","term":"Defect","term_zh":"缺陷","aliases":["defects"],"definition_zh":"可能引起产品性能异常、失效或良率损失的不期望偏差。","category":"Yield & Defect Control"},
    {"id":"defect-density","term":"Defect Density","term_zh":"缺陷密度","definition_zh":"单位面积内缺陷数量，用于关联芯片面积与良率。","category":"Yield & Defect Control"},
    {"id":"killer-defect","term":"Killer Defect","term_zh":"致命缺陷","aliases":["killer defects","killer-defect"],"definition_zh":"足以造成电路开路、短路或功能失效的缺陷。","category":"Yield & Defect Control"},
    {"id":"particle-contamination","term":"Particle Contamination","term_zh":"颗粒污染","definition_zh":"不期望颗粒进入制造环境或附着晶圆而影响工艺与良率的现象。","category":"Contamination & Inspection"},
    {"id":"particle-per-wafer-per-pass","term":"Particle per Wafer per Pass","term_zh":"每片晶圆每次通过新增颗粒数","aliases":["Particles per Wafer per Pass","PWP"],"definition_zh":"比较晶圆进出设备前后的颗粒数，以量化单次设备过程新增颗粒。","category":"Contamination & Inspection"},
    {"id":"cleanroom","term":"Cleanroom","term_zh":"洁净室","definition_zh":"对空气颗粒、气流、温湿度和人员活动进行控制的制造环境。","category":"Contamination & Inspection"},
    {"id":"mini-environment","term":"Mini-environment","term_zh":"微环境","aliases":["mini-environments"],"definition_zh":"在设备或关键区域周围建立的局部高洁净度受控空间。","category":"Contamination & Inspection"},
    {"id":"hepa-filter","term":"High Efficiency Particulate Air","term_zh":"高效颗粒空气过滤器","aliases":["HEPA"],"definition_zh":"在洁净室循环空气中高效去除微小颗粒的过滤系统。","category":"Contamination & Inspection"},
    {"id":"laminar-air-flow","term":"Laminar Air Flow","term_zh":"层流气流","definition_zh":"方向一致、扰动较小的气流组织，用于降低颗粒回流和沉积。","category":"Contamination & Inspection"},
    {"id":"deionized-water","term":"Deionized Water","term_zh":"去离子水","aliases":["Deionized (DI) Water","DI water","DI"],"definition_zh":"去除大部分离子杂质、用于晶圆清洗和最终漂洗的高纯水。","category":"Contamination & Inspection"},
    {"id":"rca-cleaning","term":"RCA Cleaning","term_zh":"RCA 标准清洗","definition_zh":"使用标准化湿法化学步骤去除晶圆表面有机物、颗粒和金属污染的清洗流程。","category":"Contamination & Inspection"},
    {"id":"standard-clean-one","term":"SC-1","term_zh":"标准清洗液一","definition_zh":"RCA 清洗中常用于去除有机污染和颗粒的碱性清洗步骤。","category":"Contamination & Inspection"},
    {"id":"standard-clean-two","term":"SC-2","term_zh":"标准清洗液二","definition_zh":"RCA 清洗中常用于去除金属离子污染的酸性清洗步骤。","category":"Contamination & Inspection"},
    {"id":"mobile-metal-contamination","term":"Mobile-Metal Contamination","term_zh":"可移动金属污染","aliases":["mobile metal contamination"],"definition_zh":"可在氧化层或器件结构中迁移并改变电学特性的金属离子污染。","category":"Contamination & Inspection"},
    {"id":"membrane-filtration","term":"Membrane Filtration","term_zh":"膜过滤","definition_zh":"利用膜的孔径或选择性从液体或气体中分离颗粒的技术。","category":"Contamination & Inspection"},
    {"id":"electrostatic-filtration","term":"Electrostatic Filtration","term_zh":"静电过滤","definition_zh":"利用电荷吸引并捕集空气中颗粒的过滤方法。","category":"Contamination & Inspection"},
    {"id":"automated-optical-inspection","term":"Automated Optical Inspection","term_zh":"自动光学检测","aliases":["AOI"],"definition_zh":"结合光学成像与自动化分析进行表面和图形缺陷检测的技术。","category":"Contamination & Inspection"},
    {"id":"charge-coupled-device","term":"Charge-Coupled Device","term_zh":"电荷耦合器件","aliases":["charge-coupled-device","CCD"],"definition_zh":"将光信号转换并转移为电荷信号的成像传感器。","category":"Contamination & Inspection"},
    {"id":"bright-field","term":"Bright-Field","term_zh":"明场显微","aliases":["bright field","bright-field microscopy"],"definition_zh":"以明亮背景观察样品吸收或散射造成对比的显微成像模式。","category":"Contamination & Inspection"},
    {"id":"dark-field","term":"Dark-Field","term_zh":"暗场显微","aliases":["dark field","dark-field microscopy"],"definition_zh":"使散射特征在暗背景上呈亮像、突出边缘与微粒的成像模式。","category":"Contamination & Inspection"},
    {"id":"test-structure","term":"Test Structure","term_zh":"测试结构","aliases":["test structures","test dies"],"definition_zh":"布置在晶圆上的专用结构，用于电学监控制造过程。","category":"Contamination & Inspection"},
    {"id":"scribe-line","term":"Scribe Line","term_zh":"划片道","aliases":["scribe lines"],"definition_zh":"相邻芯片间预留给切割并可放置测试结构的区域。","category":"Contamination & Inspection"},
    {"id":"defect-segmentation","term":"Defect Segmentation","term_zh":"缺陷分割","definition_zh":"从检测图像中定位并分离疑似异常区域的处理过程。","category":"Contamination & Inspection"},
    {"id":"defect-clustering","term":"Defect Clustering","term_zh":"缺陷聚类","definition_zh":"依据空间或属性相关性将缺陷分组，以识别系统性来源。","category":"Contamination & Inspection"},
    {"id":"wafer-map","term":"Wafer Map","term_zh":"晶圆图","aliases":["wafer maps","defect map","defect maps"],"definition_zh":"以晶圆空间位置展示测试结果或缺陷分布的图。","category":"Contamination & Inspection"},
    {"id":"root-cause-analysis","term":"Root Cause Analysis","term_zh":"根本原因分析","aliases":["root-cause analysis","RCA"],"definition_zh":"从表面症状追溯并验证导致问题的底层原因的系统方法。","category":"Problem Solving"},
    {"id":"five-whys","term":"5 Whys","term_zh":"五问法","definition_zh":"反复追问“为什么”以从直接原因深入到底层根因的分析方法。","category":"Problem Solving"},
    {"id":"corrective-action","term":"Corrective Action","term_zh":"纠正措施","aliases":["corrective-action","CA"],"definition_zh":"针对已识别根因实施的过程、设备、程序或培训变更。","category":"Problem Solving"},
    {"id":"preventive-action","term":"Preventive Action","term_zh":"预防措施","aliases":["PA"],"definition_zh":"验证措施效果、防止问题再次发生并推广经验的后续行动。","category":"Problem Solving"},
    {"id":"statistical-process-control","term":"Statistical Process Control","term_zh":"统计过程控制","aliases":["SPC"],"definition_zh":"利用时间序列数据和统计规则监测并控制过程稳定性的方法。","category":"Statistical Process Control"},
    {"id":"control-chart","term":"Control Chart","term_zh":"控制图","aliases":["control-chart"],"definition_zh":"按时间绘制过程统计量并配合控制界限识别异常变差的图表。","category":"Statistical Process Control"},
    {"id":"process-variation","term":"Process Variation","term_zh":"过程变差","aliases":["process variability"],"definition_zh":"过程输出随时间、设备、材料等因素产生的波动。","category":"Statistical Process Control"},
    {"id":"special-cause-variation","term":"Special-Cause Variation","term_zh":"特殊原因变差","aliases":["special cause variation"],"definition_zh":"由可识别异常因素造成、超出过程正常表现的变差。","category":"Statistical Process Control"},
    {"id":"common-cause-variation","term":"Common-Cause Variation","term_zh":"普通原因变差","aliases":["common cause variation"],"definition_zh":"内在于当前过程系统、构成其长期正常波动的变差。","category":"Statistical Process Control"},
    {"id":"control-limits","term":"Control Limits","term_zh":"控制界限","definition_zh":"根据过程自然变差计算、用于判断统计受控状态的界限。","category":"Statistical Process Control"},
    {"id":"upper-control-limit","term":"Upper Control Limit","term_zh":"控制上限","aliases":["UCL"],"definition_zh":"控制图上用于识别异常偏高结果的统计界限。","category":"Statistical Process Control"},
    {"id":"lower-control-limit","term":"Lower Control Limit","term_zh":"控制下限","aliases":["LCL"],"definition_zh":"控制图上用于识别异常偏低结果的统计界限。","category":"Statistical Process Control"},
    {"id":"specification-limits","term":"Specification Limits","term_zh":"规格界限","definition_zh":"由客户或设计要求外部规定的产品或过程接受边界。","category":"Statistical Process Control"},
    {"id":"upper-specification-limit","term":"Upper Specification Limit","term_zh":"规格上限","aliases":["USL"],"definition_zh":"规格允许范围的最高边界。","category":"Statistical Process Control"},
    {"id":"lower-specification-limit","term":"Lower Specification Limit","term_zh":"规格下限","aliases":["LSL"],"definition_zh":"规格允许范围的最低边界。","category":"Statistical Process Control"},
    {"id":"western-electric-rules","term":"Western Electric Rules","term_zh":"西部电气判异规则","aliases":["R1-3","R4-6","R7"],"definition_zh":"利用控制图点位组合模式识别非随机过程变化的一组规则。","category":"Statistical Process Control"},
    {"id":"average-run-length","term":"Average Run Length","term_zh":"平均链长","aliases":["ARL"],"definition_zh":"控制图从开始监测到发出信号前平均需要观察的样本点数。","category":"Statistical Process Control"},
    {"id":"process-capability","term":"Process Capability","term_zh":"过程能力","definition_zh":"稳定过程的自然变差相对于规格要求的满足能力。","category":"Statistical Process Control"},
    {"id":"cp","term":"Cp","term_zh":"过程能力指数 Cp","definition_zh":"规格宽度与六倍过程标准差之比，不考虑过程是否居中。","category":"Statistical Process Control"},
    {"id":"cpk","term":"Cpk","term_zh":"过程能力指数 Cpk","definition_zh":"考虑过程均值到较近规格界限距离的过程能力指数。","category":"Statistical Process Control"},
    {"id":"process-centering","term":"Process Centering","term_zh":"过程居中性","definition_zh":"过程均值相对于目标值或规格区间中心的位置状态。","category":"Statistical Process Control"},
    {"id":"out-of-control","term":"Out-of-Control","term_zh":"失控","aliases":["OOC"],"definition_zh":"统计证据表明过程可能受到特殊原因影响的状态。","category":"Statistical Process Control"},
    {"id":"out-of-control-action-plan","term":"Out-of-Control Action Plan","term_zh":"失控行动计划","aliases":["OCAP"],"definition_zh":"控制图触发失控信号后规定调查、调整、升级和验证步骤的计划。","category":"Statistical Process Control"},
    {"id":"critical-to-quality","term":"Critical to Quality","term_zh":"质量关键特性","aliases":["CTQ"],"definition_zh":"直接影响最终产品性能或客户满意度、需重点控制的参数。","category":"Process Control & Metrology"},
    {"id":"hard-specification","term":"Hard Specification","term_zh":"硬规格","aliases":["hard specifications"],"definition_zh":"判定标准明确、可直接用于生产线上产品处置的规格。","category":"Process Control & Metrology"},
    {"id":"soft-specification","term":"Soft Specification","term_zh":"软规格","aliases":["soft specifications"],"definition_zh":"判定或处置标准不够明确、通常需要工程判断的规格。","category":"Process Control & Metrology"},
    {"id":"metrology","term":"Metrology","term_zh":"计量学","definition_zh":"研究测量、标准、校准以及测量不确定性和能力的领域。","category":"Process Control & Metrology"},
    {"id":"gage-capability-study","term":"Gage Capability Study","term_zh":"量具能力研究","definition_zh":"验证测量系统能否足够准确可靠地反映真实零件状态的研究。","category":"Process Control & Metrology"},
    {"id":"measurement-standard","term":"Measurement Standard","term_zh":"测量标准","aliases":["measurement standards"],"definition_zh":"用于量值溯源、相关性确认与测量控制的参考基准。","category":"Process Control & Metrology"},
    {"id":"bias","term":"Bias","term_zh":"测量偏倚","definition_zh":"测量平均值相对于真实值或参考值的系统性差异。","category":"Process Control & Metrology"},
    {"id":"linearity","term":"Linearity","term_zh":"线性度","definition_zh":"测量系统偏倚在整个测量范围内保持一致的程度。","category":"Process Control & Metrology"},
    {"id":"repeatability","term":"Repeatability","term_zh":"重复性","definition_zh":"同一操作者和设备在相同条件下重复测量的一致程度。","category":"Process Control & Metrology"},
    {"id":"reproducibility","term":"Reproducibility","term_zh":"再现性","definition_zh":"不同操作者、设备或条件之间测量结果的一致程度。","category":"Process Control & Metrology"},
    {"id":"stability","term":"Stability","term_zh":"稳定性","definition_zh":"测量系统或过程特性随时间保持一致的能力。","category":"Process Control & Metrology"},
    {"id":"process-characterization","term":"Process Characterization","term_zh":"过程表征","definition_zh":"系统识别过程输入、输出、关系及变差来源的活动。","category":"Process Control & Metrology"},
    {"id":"design-of-experiments","term":"Design of Experiments","term_zh":"试验设计","aliases":["DOE"],"definition_zh":"有计划地改变多个因素并分析其对响应影响的统计方法。","category":"Process Control & Metrology"},
    {"id":"regression-analysis","term":"Regression Analysis","term_zh":"回归分析","aliases":["regression"],"definition_zh":"建立响应变量与一个或多个解释变量之间定量关系的方法。","category":"Process Control & Metrology"},
    {"id":"fishbone-diagram","term":"Fishbone Diagram","term_zh":"鱼骨图","definition_zh":"从人、机、料、法、环、测等分支系统梳理潜在原因的图示工具。","category":"Process Control & Metrology"},
    {"id":"sampling-plan","term":"Sampling Plan","term_zh":"抽样计划","aliases":["sampling-plan"],"definition_zh":"规定抽样对象、数量、位置、频率和分组方式的方案。","category":"Process Control & Metrology"},
    {"id":"confidence-interval","term":"Confidence Interval","term_zh":"置信区间","aliases":["confidence intervals"],"definition_zh":"在给定置信水平下对总体参数可能范围的区间估计。","category":"Process Control & Metrology"},
    {"id":"rational-subgroup","term":"Rational Subgroup","term_zh":"合理子组","definition_zh":"按过程独立性与变差结构组成、用于控制图分析的一组观测。","category":"Process Control & Metrology"},
    {"id":"time-series","term":"Time-Series","term_zh":"时间序列","aliases":["time-series order"],"definition_zh":"按发生时间顺序记录和分析的一系列测量结果。","category":"Process Control & Metrology"},
    {"id":"variable-data","term":"Variable Data","term_zh":"计量型数据","definition_zh":"以连续数值尺度测得的数据，如厚度或尺寸。","category":"Process Control & Metrology"},
    {"id":"attribute-data","term":"Attribute Data","term_zh":"计数型数据","definition_zh":"以类别、合格与否或缺陷计数表示的数据。","category":"Process Control & Metrology"},
    {"id":"xbar-s-chart","term":"X̄ & S chart","term_zh":"均值-标准差控制图","definition_zh":"同时用子组均值和标准差监控过程位置与离散程度的控制图。","category":"Process Control & Metrology"},
    {"id":"np-chart","term":"NP chart","term_zh":"不合格品数控制图","definition_zh":"在固定样本量下监控不合格单位数量的计数型控制图。","category":"Process Control & Metrology"},
    {"id":"c-chart","term":"C chart","term_zh":"缺陷数控制图","definition_zh":"在固定检验机会下监控单位缺陷数量的控制图。","category":"Process Control & Metrology"},
    {"id":"u-chart","term":"U chart","term_zh":"单位缺陷数控制图","definition_zh":"样本量或检验机会变化时监控单位平均缺陷数的控制图。","category":"Process Control & Metrology"},
    {"id":"closed-loop-control","term":"Closed-Loop","term_zh":"闭环控制","aliases":["closed-loop response","closed-loop process-control"],"definition_zh":"利用测量反馈调整输入并再次验证结果的控制方式。","category":"Process Control & Metrology"},
    {"id":"process-adjust-matrix","term":"Process-Adjust Matrix","term_zh":"过程调整矩阵","definition_zh":"根据偏差、允许范围和规则确定调整变量与调整量的表格。","category":"Process Control & Metrology"},
    {"id":"wafer-cleaning","term":"Wafer Cleaning","term_zh":"晶圆清洗","definition_zh":"去除晶圆表面颗粒、有机物、金属和自然氧化层等污染的工艺。","category":"Wafer Process"},
    {"id":"dry-cleaning","term":"Dry Cleaning","term_zh":"干式清洗","definition_zh":"不使用液体清洗槽、借助气相或等离子体去除表面污染的方法。","category":"Wafer Process"},
    {"id":"plasma-cleaning","term":"Plasma Cleaning","term_zh":"等离子体清洗","aliases":["Ar/H2 Plasma Cleaning"],"definition_zh":"利用等离子体活性物种或离子作用清洁材料表面的工艺。","category":"Wafer Process"},
    {"id":"thermal-cleaning","term":"Thermal Cleaning","term_zh":"热清洗","definition_zh":"利用加热促进表面污染物脱附或分解的清洗方法。","category":"Wafer Process"},
    {"id":"mask-generation","term":"Mask Generation","term_zh":"掩模版制作","definition_zh":"将电路版图转换并写入光刻掩模的制造流程。","category":"Patterning & Etch"},
    {"id":"wafer-exposure-system","term":"Wafer Exposure Systems","term_zh":"晶圆曝光系统","definition_zh":"把掩模图形通过光学系统投影到涂胶晶圆上的设备。","category":"Patterning & Etch"},
    {"id":"ultraviolet","term":"Ultraviolet","term_zh":"紫外线","aliases":["UV"],"definition_zh":"波长短于可见光、常用于光刻曝光与表面清洗的电磁辐射。","category":"Patterning & Etch"},
    {"id":"hydrogen-ion","term":"Hydrogen Ion","term_zh":"氢离子","aliases":["H+"],"definition_zh":"带正电的氢离子，在酸性湿法化学反应中参与材料去除。","category":"Patterning & Etch"},
    {"id":"low-pressure-cvd","term":"Low-Pressure Chemical Vapor Deposition","term_zh":"低压化学气相沉积","aliases":["LPCVD"],"definition_zh":"在低压环境中进行、常用于获得均匀薄膜的化学气相沉积工艺。","category":"Thin Films & Interconnect"},
    {"id":"radio-frequency","term":"Radio Frequency","term_zh":"射频","aliases":["RF"],"definition_zh":"用于无线通信或等离子体激励等场景的高频电磁信号范围。","category":"Devices & Memory"},
    {"id":"latch-up","term":"Latch-up","term_zh":"闩锁效应","aliases":["LU"],"definition_zh":"CMOS 寄生结构被触发后形成低阻大电流通路的可靠性失效。","category":"Reliability & Failure"},
    {"id":"soft-error-rate","term":"Soft Error Rate","term_zh":"软错误率","aliases":["SER"],"definition_zh":"器件发生不造成永久物理损伤的瞬态数据错误的频率。","category":"Reliability & Failure"},
    {"id":"data-retention","term":"Data Retention","term_zh":"数据保持能力","definition_zh":"存储器在规定时间和条件下维持所存信息的能力。","category":"Reliability & Failure"},
    {"id":"positive-pressure","term":"Positive Pressure","term_zh":"正压","definition_zh":"使洁净区压力高于外部，以阻止未过滤空气进入的环境控制方式。","category":"Contamination & Inspection"},
    {"id":"wafer-yield","term":"Wafer Yield","term_zh":"晶圆良率","aliases":["YW"],"definition_zh":"完成晶圆级制造要求的晶圆所占比例。","category":"Yield & Defect Control"},
    {"id":"die-yield","term":"Die Yield","term_zh":"芯片良率","aliases":["YD"],"definition_zh":"一片晶圆上功能合格裸片占全部裸片的比例。","category":"Yield & Defect Control"},
    {"id":"packaging-yield","term":"Packaging Yield","term_zh":"封装良率","aliases":["YC"],"definition_zh":"经过封装组装后达到要求的器件所占比例。","category":"Yield & Defect Control"},
    {"id":"overall-fab-yield","term":"Overall Fab Yield","term_zh":"工厂总良率","aliases":["YT"],"definition_zh":"由晶圆、裸片和封装等阶段良率共同决定的总体产出比例。","category":"Yield & Defect Control"},
    {"id":"zusl","term":"ZUSL","term_zh":"均值至规格上限的标准差距离","definition_zh":"过程均值到规格上限的距离，以过程标准差倍数表示。","category":"Statistical Process Control"},
    {"id":"zlsl","term":"ZLSL","term_zh":"均值至规格下限的标准差距离","definition_zh":"过程均值到规格下限的距离，以过程标准差倍数表示。","category":"Statistical Process Control"},
    {"id":"lightly-doped-drain-extension","term":"Lightly Doped Drain/Source-Drain Extension","term_zh":"轻掺杂漏极/源漏延伸区","aliases":["LDD/SDE"],"definition_zh":"位于沟道和重掺杂源漏之间、用于缓和电场峰值的轻掺杂区域。","category":"Devices & Memory"},
    {"id":"ultraviolet-ozone-cleaning","term":"Ultraviolet Ozone Cleaning","term_zh":"紫外臭氧清洗","aliases":["UVOC"],"definition_zh":"利用紫外激发产生的臭氧和活性氧去除表面碳氢污染的干式清洗。","category":"Wafer Process"},
